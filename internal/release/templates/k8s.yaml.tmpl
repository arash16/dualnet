# Generated by `dualnet compile` — do not edit by hand.
#
# {{.Variant}} variant for node {{.Node}}. The PSK is NOT in this file; deploy.sh creates
# Secret/{{.Deployment}} from $DUALNET_PSK and DUALNET_PSK overrides the config's psk at runtime.
apiVersion: v1
kind: ConfigMap
metadata:
  name: {{.Deployment}}-config
data:
  node.yaml: |
{{ indent 4 .ConfigYAML }}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{.Deployment}}
  labels: { app: {{.Deployment}} }
spec:
  replicas: 1
  # Single gateway with in-memory session state — never run two at once.
  strategy: { type: Recreate }
  selector:
    matchLabels: { app: {{.Deployment}} }
  template:
    metadata:
      labels: { app: {{.Deployment}} }
    spec:
{{- if eq .Variant "hostNetwork" }}
      hostNetwork: true
      dnsPolicy: Default
{{- end }}
      containers:
        - name: dualnet
          image: {{.Image}}
          imagePullPolicy: {{.PullPolicy}}
          args: ["-config", "/etc/dualnet/node.yaml"]
          env:
            - name: DUALNET_PSK
              valueFrom:
                secretKeyRef: { name: {{.Deployment}}, key: psk }
          ports:
{{- range .Ports }}
            - { containerPort: {{.Port}}, protocol: {{.Protocol}} }
{{- end }}
{{- if .Privileged }}
          securityContext: { privileged: true } # kernel egress / tun needs NET_ADMIN + iptables + sysctl
{{- end }}
          volumeMounts:
            - { name: config, mountPath: /etc/dualnet, readOnly: true }
{{- if .Privileged }}
            - { name: tun, mountPath: /dev/net/tun }
{{- end }}
      volumes:
        - { name: config, configMap: { name: {{.Deployment}}-config } }
{{- if .Privileged }}
        - { name: tun, hostPath: { path: /dev/net/tun, type: CharDevice } }
{{- end }}
{{- if eq .Variant "service" }}
---
apiVersion: v1
kind: Service
metadata:
  name: {{.Deployment}}
spec:
  type: LoadBalancer
  externalTrafficPolicy: Local # preserve client source IP (a Multiple listener learns it)
  selector: { app: {{.Deployment}} }
  ports:
{{- range .Ports }}
    - { name: p{{.Port}}, port: {{.Port}}, targetPort: {{.Port}}, protocol: {{.Protocol}} }
{{- end }}
{{- end }}
