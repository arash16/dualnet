#!/usr/bin/env bash
# Generated by `dualnet compile` from {{.Network}} — do not edit by hand.
#
# Build step: cross-compile dualnet for every recipe this mesh declares (once each, into
# dist/) and build the container image for every k8s node. This CREATES ARTIFACTS ONLY — it
# never contacts a deploy host. Run deploy.sh afterwards to ship them (or `make deploy`).
#
#   ./build.sh                 build every recipe + image
#   ./build.sh --bins-only     cross-compiled binaries only (skip the container images)
#
# Override the source checkout with $DUALNET_REPO if it differs from where compile ran.
set -uo pipefail

REPO_ROOT="${DUALNET_REPO:-{{.RepoRoot}}}"
OUT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DIST="$REPO_ROOT/dist"

log()  { printf '%s\n' "$*" >&2; }
die()  { printf '!! %s\n' "$*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

# ---- generated build matrix (the only per-mesh content) --------------------
# out|goarch|goarm|upx
GO_BUILDS=(
{{- range .GoBuilds}}
  "{{.Out}}|{{.GOARCH}}|{{.GOARM}}|{{if .Upx}}1{{else}}0{{end}}"
{{- end}}
)
# image|platform|bin
DOCKER_BUILDS=(
{{- range .Docker}}
  "{{.Image}}|{{.Platform}}|{{.Bin}}"
{{- end}}
)

BINS_ONLY=0
for a in "$@"; do
  case "$a" in
    --bins-only) BINS_ONLY=1 ;;
    *)           die "unknown argument: $a (use --bins-only)" ;;
  esac
done

# ---- cross-compile every recipe once into dist/ ----------------------------
mkdir -p "$DIST"
rec=""; out=""; goarch=""; goarm=""; upx=""
if [ ${#GO_BUILDS[@]} -gt 0 ]; then
  for rec in "${GO_BUILDS[@]}"; do
    IFS='|' read -r out goarch goarm upx <<<"$rec"
    log "== build $out (linux/$goarch${goarm:+/v$goarm}) =="
    if ! ( cd "$REPO_ROOT" && env CGO_ENABLED=0 GOOS=linux GOARCH="$goarch" ${goarm:+GOARM="$goarm"} \
           go build -trimpath -ldflags="-s -w" -o "$DIST/$out" . ); then
      die "go build $out failed"
    fi
    if [ "$upx" = 1 ]; then
      if have upx; then upx --best --lzma "$DIST/$out" >/dev/null 2>&1 && log "  upx compressed"
      else log "  upx not found (brew install upx); leaving uncompressed"; fi
    fi
  done
fi

[ "$BINS_ONLY" = 1 ] && { log "bins-only: done ($DIST)"; exit 0; }

# ---- wrap each prebuilt binary in its runtime image (loaded LOCALLY) -------
# Images are only built here, never delivered: deploy.sh pushes them to a registry or
# `docker save | ssh <host> ctr import`s them. So build.sh has no outward side effects.
image=""; platform=""; bin=""
if [ ${#DOCKER_BUILDS[@]} -gt 0 ]; then
  have docker || die "docker required to build images (or pass --bins-only)"
  for rec in "${DOCKER_BUILDS[@]}"; do
    IFS='|' read -r image platform bin <<<"$rec"
    log "== image $image ($platform) =="
    if ! docker buildx build --platform "$platform" --build-arg BIN="$bin" \
           -t "$image" -f "$OUT_DIR/Dockerfile.release" --load "$DIST"; then
      die "image build $image failed"
    fi
  done
fi
log "build: done ($DIST)"
