# Generated by `dualnet compile` — do not edit by hand.
#
# Thin runtime image wrapping a dualnet binary that deploy.sh has already cross-compiled
# (see the GO_BUILDS table). The binary — optionally upx-compressed per its build recipe —
# is passed as --build-arg BIN and COPYd in, so a build's arch/upx flow identically into the
# image and into ssh-shipped binaries. Runtime deps mirror the root Dockerfile: iproute2 +
# iptables (nft backend, matching a k3s host) for tunnel setup and kernel-egress NAT.
FROM debian:bookworm-slim
ARG BIN
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates iproute2 iptables \
    && rm -rf /var/lib/apt/lists/*
COPY ${BIN} /usr/local/bin/dualnet
ENTRYPOINT ["dualnet"]
# Args are supplied by the deployment (e.g. -config /etc/dualnet/node.yaml).
CMD ["-h"]
