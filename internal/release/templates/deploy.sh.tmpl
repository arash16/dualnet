#!/usr/bin/env bash
# Generated by `dualnet compile` from {{.Network}} — do not edit by hand.
#
# Deploy step: ship each node's prebuilt binary + config to its host and (re)start it, and
# apply each k8s node's manifest. Run build.sh FIRST (or `make deploy`, which builds then
# deploys) — this script ships artifacts, it does not create them.
#
#   ./deploy.sh                 deploy every node
#   ./deploy.sh router vps      deploy only the named nodes
#   ./deploy.sh --logs [nodes]  pull each ssh node's stats log into ./logs/<node>.jsonl
#
# The PSK is read from $DUALNET_PSK and provisioned to each host at deploy time (systemd
# drop-in / k8s Secret / inline env). It is never written into this script or the configs.
# It is passed to hosts as a raw ssh argument (works on minimal busybox with no base64), so
# it must be whitespace-free — true for any normal shared secret.
set -uo pipefail

REPO_ROOT="${DUALNET_REPO:-{{.RepoRoot}}}"
OUT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DIST="$REPO_ROOT/dist"
NETWORK="{{.Network}}"
STATS_FILE="{{.StatsFile}}"
PSK="${DUALNET_PSK:-}"

log()  { printf '%s\n' "$*" >&2; }
die()  { printf '!! %s\n' "$*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

# ---- generated node tables (the only per-mesh content) ---------------------
# node|host|opts|bin|binpath|cfgpath|cfgfile|daemonize|unit|restart_b64
SSH_NODES=(
{{- range .SSHNodes}}
  "{{.Node}}|{{.Host}}|{{.SSHOpts}}|{{.Bin}}|{{.BinPath}}|{{.ConfigPath}}|{{.ConfigFile}}|{{.Daemonize}}|{{.Unit}}|{{.RestartB64}}"
{{- end}}
)
# node|context|ns|image|method|import|manifest|deployment
K8S_NODES=(
{{- range .K8sNodes}}
  "{{.Node}}|{{.Context}}|{{.Namespace}}|{{.Image}}|{{.Method}}|{{.ImportHost}}|{{.Manifest}}|{{.Deployment}}"
{{- end}}
)
# node|local|remote  (condition data files, e.g. dst_in prefix lists; local is relative to REPO_ROOT unless absolute)
SSH_FILES=(
{{- range .SSHFiles}}
  "{{.Node}}|{{.Local}}|{{.Remote}}"
{{- end}}
)

# ---- ssh: ship one file to a host ------------------------------------------
# Try rsync, then sftp, then scp — each falling through to the next on failure, to cover the
# full spread of hosts (a Linux VPS with rsync; a busybox router with only Dropbear's SFTP):
#  - rsync: safe temp+rename, resumable, compressed; needs rsync on BOTH ends.
#  - sftp / scp: SFTP-subsystem transfers that land directly at the path (no mv). They write
#    in place, so we rm the target first — a running binary keeps its old (unlinked) inode
#    while a fresh one is written, avoiding ETXTBSY. Transfers are verified byte-exact.
# The same -o-form $opts works for all three (scp's -p means preserve-times, not port).
ship_file() { # host opts src dst
  local host="$1" opts="$2" src="$3" dst="$4"
  if command -v rsync >/dev/null 2>&1 &&
    rsync -zc --partial -e "ssh -o ConnectTimeout=10 $opts" "$src" "$host:$dst" 2>/dev/null; then
    return 0
  fi
  # in-place writers below: free the path so a running binary can be replaced.
  ssh -o ConnectTimeout=10 $opts "$host" "rm -f '$dst'" 2>/dev/null
  if command -v sftp >/dev/null 2>&1 &&
    printf 'put %s %s\n' "$src" "$dst" | sftp -q -b - -o ConnectTimeout=10 $opts "$host" >/dev/null 2>&1; then
    return 0
  fi
  if command -v scp >/dev/null 2>&1 &&
    scp -q -o ConnectTimeout=10 $opts "$src" "$host:$dst" >/dev/null 2>&1; then
    return 0
  fi
  log "  !! transfer failed on $host (tried rsync, sftp, scp)"
  return 1
}

ship_binary() { # host opts localbin rbin
  local host="$1" opts="$2" bin="$3" rbin="$4" lsha rsha
  lsha="$(shasum -a 256 "$bin" | awk '{print $1}')"
  ship_file "$host" "$opts" "$bin" "$rbin" || return 1
  ssh $opts "$host" "chmod +x '$rbin'" || return 1
  rsha="$(ssh $opts "$host" "sha256sum '$rbin' 2>/dev/null || shasum -a 256 '$rbin' 2>/dev/null" | awk '{print $1}')"
  if [ -z "$rsha" ]; then
    log "  binary shipped ($host has no sha256 tool to verify)"
  elif [ "$lsha" != "$rsha" ]; then
    log "  !! sha mismatch on $host (local=$lsha remote=$rsha)"; return 1
  else
    log "  binary ok ($lsha)"
  fi
}

ship_config() { # host opts localcfg rcfg
  ship_file "$1" "$2" "$3" "$4" || return 1
  log "  config -> $4"
}

# ---- ssh restart strategies (PSK passed raw as a positional; see header) ---
restart_systemd() { # host opts unit binpath cfgpath
  local host="$1" opts="$2" unit="$3" binpath="$4" cfgpath="$5"
  # STATS is optional and goes LAST: an empty arg mid-list is dropped when ssh joins the
  # command, which would shift the positionals. As the trailing arg it is simply absent, so
  # ${5:-} defaults it cleanly. PSK is passed raw (must be whitespace-free — see header).
  ssh -o ConnectTimeout=10 $opts "$host" sh -s "$unit" "$binpath" "$cfgpath" "$PSK" "$STATS_FILE" <<'REMOTE'
set -u
UNIT="$1"; BIN="$2"; CFG="$3"; PSK="$4"; STATS="${5:-}"
SUDO=""; [ "$(id -u)" -ne 0 ] && SUDO="sudo -n"
UF="/etc/systemd/system/$UNIT.service"
printf '[Unit]\nDescription=dualnet node\nAfter=network-online.target\nWants=network-online.target\n\n[Service]\nExecStart=%s -config %s\nRestart=always\nRestartSec=2\n\n[Install]\nWantedBy=multi-user.target\n' "$BIN" "$CFG" | $SUDO tee "$UF" >/dev/null
$SUDO mkdir -p "$UF.d"
printf '[Service]\nEnvironment=DUALNET_PSK=%s\n' "$PSK" | $SUDO tee "$UF.d/psk.conf" >/dev/null
$SUDO chmod 600 "$UF.d/psk.conf"
[ -n "$STATS" ] && $SUDO rm -f "$STATS" 2>/dev/null && echo "  cleared $STATS"
$SUDO systemctl daemon-reload
$SUDO systemctl enable "$UNIT" >/dev/null 2>&1 || true
$SUDO systemctl restart "$UNIT"
sleep 1
echo "  is-active: $($SUDO systemctl is-active "$UNIT" 2>/dev/null || true)"
REMOTE
}

# daemonize=none: just launch it. dualnet's singleton kills any prior instance on this path.
# Kept minimal for busybox: no base64/printf/setsid/nohup — PSK is passed raw and the process
# is detached with whatever exists (setsid > nohup > a plain redirected background job, which
# survives the ssh exit because its fds point at files, not the ssh channel).
launch_none() { # host opts binpath cfgpath
  local host="$1" opts="$2" binpath="$3" cfgpath="$4"
  ssh -o ConnectTimeout=10 $opts "$host" sh -s "$binpath" "$cfgpath" "$PSK" <<'REMOTE'
set -u
BIN="$1"; CFG="$2"; export DUALNET_PSK="$3"
if command -v setsid >/dev/null 2>&1; then
  setsid "$BIN" -config "$CFG" </dev/null >/tmp/dualnet.log 2>&1 &
elif command -v nohup >/dev/null 2>&1; then
  nohup "$BIN" -config "$CFG" </dev/null >/tmp/dualnet.log 2>&1 &
else
  "$BIN" -config "$CFG" </dev/null >/tmp/dualnet.log 2>&1 &
fi
sleep 1
echo "  launched (log /tmp/dualnet.log)"
REMOTE
}

# restart_cmd override: run the operator's command with the PSK exported. The command is
# base64'd (it may contain spaces/quotes/newlines), so this path needs base64 on the host —
# fine for a full host that opts into restart_cmd; a busybox host would use daemonize:none.
run_restart_cmd() { # host opts cmd_b64
  local host="$1" opts="$2" cb="$3"
  ssh -o ConnectTimeout=10 $opts "$host" sh -s "$cb" "$PSK" <<'REMOTE'
set -u
CB="$1"; export DUALNET_PSK="$2"
CMD="$(printf %s "$CB" | base64 -d 2>/dev/null || printf %s "$CB" | openssl base64 -d -A 2>/dev/null)"
sh -c "$CMD"
REMOTE
}

deploy_ssh() { # record
  local rec="$1" node host opts bin binpath cfgpath cfgfile daemonize unit rb64
  local f fnode flocal fremote fsrc
  IFS='|' read -r node host opts bin binpath cfgpath cfgfile daemonize unit rb64 <<<"$rec"
  log "== $node (ssh $host) =="
  [ -f "$DIST/$bin" ] || { log "  !! $DIST/$bin not built — run ./build.sh (or make build) first"; return 1; }
  ssh -o ConnectTimeout=10 $opts "$host" \
    "mkdir -p \"\$(dirname '$binpath')\" \"\$(dirname '$cfgpath')\" 2>/dev/null \
     || sudo -n mkdir -p \"\$(dirname '$binpath')\" \"\$(dirname '$cfgpath')\"" >/dev/null 2>&1 || true
  ship_binary "$host" "$opts" "$DIST/$bin" "$binpath" || { log "  !! binary ship failed"; return 1; }
  ship_config "$host" "$opts" "$OUT_DIR/$cfgfile" "$cfgpath" || { log "  !! config ship failed"; return 1; }
  # ship any condition data files (dst_in prefix lists) this node reads.
  if [ ${#SSH_FILES[@]} -gt 0 ]; then
    for f in "${SSH_FILES[@]}"; do
      IFS='|' read -r fnode flocal fremote <<<"$f"
      [ "$fnode" = "$node" ] || continue
      case "$flocal" in /*) fsrc="$flocal" ;; *) fsrc="$REPO_ROOT/$flocal" ;; esac
      [ -f "$fsrc" ] || { log "  !! condition file not found: $fsrc"; return 1; }
      ship_file "$host" "$opts" "$fsrc" "$fremote" || { log "  !! file ship failed: $fremote"; return 1; }
      log "  file -> $fremote"
    done
  fi
  if [ -n "$rb64" ]; then
    run_restart_cmd "$host" "$opts" "$rb64" || { log "  !! restart_cmd failed"; return 1; }
  elif [ "$daemonize" = systemd ]; then
    restart_systemd "$host" "$opts" "$unit" "$binpath" "$cfgpath" || { log "  !! systemd restart failed"; return 1; }
  else
    launch_none "$host" "$opts" "$binpath" "$cfgpath" || { log "  !! launch failed"; return 1; }
  fi
}

deploy_k8s() { # record
  local rec="$1" node ctx ns image method import manifest deployment kc
  IFS='|' read -r node ctx ns image method import manifest deployment <<<"$rec"
  log "== $node (k8s${ctx:+ context=$ctx} ns=$ns) =="
  have kubectl || { log "  !! kubectl not found"; return 1; }
  kc="kubectl"; [ -n "$ctx" ] && kc="kubectl --context $ctx"; kc="$kc -n $ns"
  # Deliver the locally-built image (build.sh --load'd it) to where the cluster pulls from.
  case "$method" in
    registry)
      have docker || { log "  !! docker not found"; return 1; }
      log "  pushing $image"
      docker push "$image" || { log "  !! push failed (docker login?)"; return 1; } ;;
    ctr)
      have docker || { log "  !! docker not found"; return 1; }
      log "  importing $image into $import via ctr"
      docker save "$image" | ssh -o ConnectTimeout=10 "$import" \
        'ctr -n k8s.io images import - 2>/dev/null || k3s ctr -n k8s.io images import -' \
        || { log "  !! ctr import failed"; return 1; } ;;
  esac
  # PSK Secret from stdin (never in argv); ConfigMap + Deployment come from the manifest.
  printf '%s' "$PSK" | $kc create secret generic "$deployment" --from-file=psk=/dev/stdin \
    --dry-run=client -o yaml | $kc apply -f - >/dev/null || { log "  !! secret failed"; return 1; }
  $kc apply -f "$OUT_DIR/$manifest" || { log "  !! apply failed"; return 1; }
  $kc rollout restart "deploy/$deployment" || { log "  !! rollout restart failed"; return 1; }
  $kc rollout status "deploy/$deployment" --timeout=90s || log "  !! rollout not ready yet"
}

fetch_logs() {
  [ -n "$STATS_FILE" ] || die "no stats_file configured in $NETWORK"
  [ ${#SSH_NODES[@]} -gt 0 ] || { log "no ssh nodes to pull logs from"; return 0; }
  mkdir -p "$OUT_DIR/logs"
  local rec node host opts rest
  for rec in "${SSH_NODES[@]}"; do
    IFS='|' read -r node host opts rest <<<"$rec"
    want "$node" || continue
    log "== $host:$STATS_FILE -> logs/$node.jsonl =="
    if rsync -z -e "ssh $opts" "$host:$STATS_FILE" "$OUT_DIR/logs/$node.jsonl" 2>/dev/null; then
      log "  ok ($(wc -l <"$OUT_DIR/logs/$node.jsonl" | tr -d ' ') snapshots)"
    else
      log "  !! no log on $host yet"
    fi
  done
}

# ---- arg parsing + dispatch ------------------------------------------------
MODE=deploy
SELECT=()
for a in "$@"; do
  case "$a" in
    --logs) MODE=logs ;;
    -*)     die "unknown flag: $a" ;;
    *)      SELECT+=("$a") ;;
  esac
done
want() { # node name
  [ ${#SELECT[@]} -eq 0 ] && return 0
  local s
  for s in "${SELECT[@]}"; do [ "$s" = "$1" ] && return 0; done
  return 1
}

if [ "$MODE" = logs ]; then fetch_logs; exit $?; fi

[ -n "$PSK" ] || die "DUALNET_PSK is not set (export it before deploying)"

rc=0
if [ ${#SSH_NODES[@]} -gt 0 ]; then
  for rec in "${SSH_NODES[@]}"; do
    IFS='|' read -r n rest <<<"$rec"
    want "$n" && { deploy_ssh "$rec" || rc=1; }
  done
fi
if [ ${#K8S_NODES[@]} -gt 0 ]; then
  for rec in "${K8S_NODES[@]}"; do
    IFS='|' read -r n rest <<<"$rec"
    want "$n" && { deploy_k8s "$rec" || rc=1; }
  done
fi
exit $rc
